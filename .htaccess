# Apache configuration for the Aruba hosting (copied to the site root by the build).

Options -MultiViews -Indexes
# /it and /it/ must not redirect to the "it" folder: /it is served from it.html.
DirectorySlash Off
DirectoryIndex index.html

AddDefaultCharset UTF-8
AddType video/mp4 .mp4
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Enable once the final domain and its SSL certificate are active ---
  # Force https:
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Always use the www version (replace example.org with the real domain):
  # RewriteCond %{HTTP_HOST} ^example\.org$ [NC]
  # RewriteRule ^ https://www.example.org%{REQUEST_URI} [L,R=301]

  # Drop trailing slashes: /it/noticias/ -> /it/noticias (the canonical form)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Pre-rendered pages: /it/noticias -> it/noticias.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Existing files (JS, CSS, images, PDFs...) are served as they are
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else is handled by the app
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Built JS/CSS/images have a content hash in the name: safe to cache for a long time
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    ExpiresDefault "access plus 1 year"
  </If>
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
